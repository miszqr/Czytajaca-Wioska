{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zadanie Czytającej Wioski — format 1",
  "type": "object",
  "required": [
    "version",
    "id",
    "revision",
    "npcId",
    "title",
    "description",
    "requires",
    "dialogue",
    "exercise",
    "feedback",
    "reward"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "not": {
        "enum": [
          "constructor",
          "prototype"
        ]
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "npcId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "not": {
        "enum": [
          "constructor",
          "prototype"
        ]
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "pattern": "\\S"
    },
    "requires": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$",
        "not": {
          "enum": [
            "constructor",
            "prototype"
          ]
        }
      },
      "uniqueItems": true
    },
    "dialogue": {
      "type": "object",
      "required": [
        "intro",
        "active",
        "completed",
        "acceptLabel",
        "replayLabel"
      ],
      "properties": {
        "intro": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200,
            "pattern": "\\S"
          }
        },
        "active": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200,
            "pattern": "\\S"
          }
        },
        "completed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200,
            "pattern": "\\S"
          }
        },
        "acceptLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "\\S"
        },
        "replayLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "exercise": {
      "type": "object",
      "required": [
        "id",
        "type",
        "prompt",
        "target",
        "choices",
        "hint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "not": {
            "enum": [
              "constructor",
              "prototype"
            ]
          }
        },
        "type": {
          "enum": [
            "syllable-choice",
            "syllable-build"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "\\S"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "\\S"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12,
            "pattern": "\\S"
          }
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "\\S"
        },
        "targetParts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "syllable-choice"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "targetParts"
              ]
            },
            "properties": {
              "choices": {
                "uniqueItems": true
              }
            }
          },
          "else": {
            "required": [
              "targetParts"
            ]
          }
        }
      ]
    },
    "feedback": {
      "type": "object",
      "required": [
        "retry",
        "success",
        "practice"
      ],
      "properties": {
        "retry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "\\S"
        },
        "success": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "\\S"
        },
        "practice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "reward": {
      "type": "object",
      "required": [
        "itemId",
        "quantity"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "not": {
            "enum": [
              "constructor",
              "prototype"
            ]
          }
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
