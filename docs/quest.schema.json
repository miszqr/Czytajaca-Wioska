{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Reading village quest",
  "type":"object",
  "required":["id","npcId","title","description","dialogue","exercise","reward","thanks"],
  "properties":{
    "id":{"type":"string"},"npcId":{"type":"string"},"title":{"type":"string"},"description":{"type":"string"},
    "dialogue":{"type":"array","minItems":1,"items":{"type":"string"}},
    "exercise":{"type":"object","required":["id","type","prompt","target","choices","hint"],"properties":{"id":{"type":"string"},"type":{"const":"syllable-choice"},"prompt":{"type":"string"},"target":{"type":"string"},"choices":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string"}},"hint":{"type":"string"}}},
    "reward":{"type":"object","required":["id","name","quantity"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"quantity":{"type":"integer","minimum":1}}},
    "thanks":{"type":"string"}
  },
  "additionalProperties":false
}
